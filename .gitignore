# ─────────────────────────────────────────────
# Subham General Store — root .gitignore
# Monorepo: backend/ (Express) + website/ (Next.js)
# ─────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment — NEVER push secrets
.env
.env.*
!.env.*.example
**/.env
**/.env.local
**/.env*.local

# Next.js build output
website/.next/
website/out/
website/build/
**/.next/
**/out/

# Production builds
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Backend uploads (user-generated files)
backend/uploads/
**/uploads/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Vercel
.vercel

# Testing / coverage
coverage/

# Temp
*.tmp
*.temp
